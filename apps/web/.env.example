# ── 필수 ────────────────────────────────────────────────────────────
# 로컬은 docker compose up -d 로 뜨는 PostgreSQL을 그대로 쓰면 됩니다.
DATABASE_URL="postgresql://oneulcourse:oneulcourse@localhost:5432/oneulcourse?schema=public"
# Supabase 등 원격 DB 공유 시: 마이그레이션(db:push, db:migrate)은 Direct Connection으로 붙어야 합니다.
# 로컬 단일 DB만 쓸 때는 DATABASE_URL과 동일한 값을 넣어도 됩니다.
DIRECT_URL="postgresql://oneulcourse:oneulcourse@localhost:5432/oneulcourse?schema=public"
APP_URL="http://localhost:3000"

# 세션 서명 키. 운영에서는 반드시 새로 만드세요.
#   openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-please"

# 스케줄러(크론) 호출 인증용
CRON_SECRET="dev-cron-secret"

# ── 선택 ────────────────────────────────────────────────────────────
# 아래 값들은 없어도 앱이 정상 실행됩니다.
# 비어 있으면 Mock 어댑터가 자동으로 선택되고, 채우면 실제 연동으로 교체됩니다.

# 카카오 로그인 (없으면 이메일 로그인만 노출)
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# 카카오 로컬 API — 장소 검색 (없으면 성수동 Mock 데이터 사용)
KAKAO_REST_API_KEY=""
KAKAO_JS_KEY=""

# OpenAI — 인터뷰·취향추출·코스생성 (없으면 규칙 기반 Mock AI 사용)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Supabase Storage — 사진 업로드 (없으면 Presigned URL 흐름만 흉내)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="oneulcourse"
